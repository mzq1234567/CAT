AZURE_CLIENT_ID=your-app-registration-client-id
DATABASE_URL=sqlite:///./cat.db
CORS_ORIGINS=["http://localhost:5173","https://your-app.azurewebsites.net"]

# Pricing engine (Azure Retail Prices API — public, no auth)
PRICING_CURRENCY=USD
PRICING_CACHE_TTL_SECONDS=86400
PRICING_DAILY_REFRESH=true

# Rate limiting + logging
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL=INFO

# Token security — verify the Azure AD RS256 signature on every request (JWKS).
# Keep this TRUE outside local dev; disabling it re-opens a tenant-isolation bypass.
VERIFY_TOKEN_SIGNATURE=true
TOKEN_ENFORCE_AUDIENCE=false
MAX_SUBSCRIPTIONS_PER_ASSESSMENT=50

# Azure API resilience (retry/backoff on 429 + circuit breaker)
AZURE_MAX_RETRIES=4
AZURE_RETRY_BASE_DELAY=0.5

# Reservation / Savings Plan basis: combined | measured | always_on | advisor
RESERVATION_BASIS=combined

# Dev-only: attach a `debug_reason` to every finding explaining why it triggered.
# TODO: remove or gate behind admin-only role before prod.
DEBUG_FINDINGS_REASONING=false
